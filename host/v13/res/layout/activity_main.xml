<?xml version="1.0" encoding="utf-8"?>
<!-- v13: Notes is a SEPARATE TAB, not a card at the bottom of the
     main screen. v12 was a half-move: the Notes BUTTON moved to the
     header, but the Notes CONTENT still lived in a collapsed card
     at the bottom and tapping the button scrolled the screen down
     to it — exactly what the user complained about ("why push it
     down like this?"). In v13 there is no bottom Notes card,
     no header Notes button, and no scroll-to-notes behaviour
     anywhere.
     Root layout: fixed header row (logo + language toggle, both
     tabs) on top, one scrollable content area in the middle
     (cloneScroll OR notesScroll, show/hide by MainActivity), and
     a fixed bottom tab bar (Clone / Ghi chú) always visible.
     Header logo: @drawable/header_logo — a CIRCULAR, background-
     cut version of the launcher icon (transparent outside the
     circle), generated per density from ic_launcher.png. The
     launcher icon itself (@mipmap/ic_launcher) is NOT changed:
     the icon on the phone's home screen stays exactly as before. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_bg">
    <!-- Header, shared by both tabs. NO app-name text on screen:
         left = circular header logo (48dp), right = language
         toggle only. The language toggle's label always shows the
         OTHER language ("English" in Vietnamese UI, "Tiếng Việt"
         in English UI); tapping it switches at once and persists. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/header_logo"
            android:contentDescription="@string/app_title"
            android:scaleType="fitCenter" />
        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="0dp" />
        <Button android:id="@+id/btnLanguageToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:text="English"
            android:background="@drawable/btn_secondary"
            android:textColor="@color/text_dark" />
    </LinearLayout>
    <!-- ================= CLONE TAB =================
         Exactly the v12 main screen minus Notes: collapsed VPN
         strip, "+ Thêm app mới", status line, clone list. -->
    <ScrollView android:id="@+id/cloneScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp">
            <!-- v6, direction A: compact collapsible VPN strip at
                 the top. UI ONLY: there is no working VPN backend
                 in this build and no WireGuard configuration exists
                 yet, so this strip must never show a fake Connected
                 state or a fake IP. The summary line always stays
                 visible; the detail block below it collapses to
                 that one line. -->
            <LinearLayout android:id="@+id/vpnStrip"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_vpn_bg"
                android:padding="12dp"
                android:layout_marginBottom="12dp">
                <TextView android:id="@+id/vpnStripSummary"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/vpn_summary_default"
                    android:textStyle="bold"
                    android:textColor="@color/teal_dark" />
                <LinearLayout android:id="@+id/vpnStripDetails"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/vpn_country_label" />
                    <Spinner android:id="@+id/vpnCountrySpinner"
                        android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/vpnIpText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/vpn_ip" />
                    <TextView android:id="@+id/vpnStateText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/vpn_state" />
                    <Button android:id="@+id/vpnConnectBtn"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/vpn_connect"
                        android:background="@drawable/btn_primary_state"
                        android:textColor="@android:color/white"
                        android:layout_marginBottom="8dp"/>
                    <TextView android:id="@+id/vpnExplain"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/vpn_explain" />
                </LinearLayout>
                <!-- v13: small secondary expand control, aligned to
                     the end, so the one-line summary stays the
                     strip's main content (v12's file still had
                     this as a full-width accent button; fixed here). -->
                <Button android:id="@+id/vpnCollapseBtn"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/vpn_collapse"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_dark" />
            </LinearLayout>
            <!-- v9, report section 09 two-path add flow: ONE
                 prominent "+" entry. Tapping it opens the choice
                 between the installed-app picker (P1) and the
                 APK-file import; both functions are unchanged. -->
            <Button android:id="@+id/btnAddApp"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/btn_add_app"
                android:textSize="18sp"
                android:background="@drawable/btn_primary"
                android:textColor="@android:color/white"
                android:layout_marginBottom="8dp"/>
            <!-- Set by code only: a short battery-exemption line on
                 open, or a transient operation result. v12 intent
                 was a 2-line cap so no failure can push the list
                 down with a wrapped dump; the v12 layout file
                 actually lacked the attribute, so v13 adds it here
                 (launch logic itself is untouched). -->
            <TextView android:id="@+id/statusText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="" />
            <LinearLayout android:id="@+id/clonesContainer"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <!-- ================= NOTES TAB =================
         The FULL former Notes content, not deleted and not
         shortened, as its own scrollable info/settings-like page.
         Always visible when this tab is selected (no collapsing,
         no scrolling down from elsewhere to reach it). -->
    <ScrollView android:id="@+id/notesScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp">
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/tab_notes"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/teal_dark"
                android:paddingBottom="8dp" />
            <LinearLayout android:id="@+id/notesContent"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="12dp">
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/notes_about_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal_dark" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/notes_about_text" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/notes_vpn_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal_dark" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/notes_vpn_text" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/notes_bubbles_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal_dark" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/notes_bubbles_text" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/notes_notif_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal_dark" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/notes_notif_text" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/notes_active_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal_dark" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/notes_active_text" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/notes_battery_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal_dark" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/notes_battery_text" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/notes_tools_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal_dark" />
                <Button android:id="@+id/btnBatteryNotes"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/notes_btn_battery"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_dark" />
                <Button android:id="@+id/btnKeepAliveNotes"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/notes_btn_keepalive"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_dark" />
                <Button android:id="@+id/btnRefreshNotes"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/notes_btn_refresh"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_dark" />
                <!-- v10: in-app self-update, now on the Notes tab.
                     Manual only: no background check, no
                     auto-download, no silent install — the system
                     installer confirmation dialog always appears. -->
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/notes_update_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal_dark" />
                <TextView android:id="@+id/updateVersionText"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/update_version_default" />
                <Button android:id="@+id/btnCheckUpdate"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/btn_check_update"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_dark" />
                <TextView android:id="@+id/updateStatusText"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <!-- ================= BOTTOM TAB BAR =================
         Fixed at the bottom, always visible on both tabs. No
         Fragment/androidx dependency: MainActivity show/hides
         the two ScrollViews above, so both tabs' views stay
         alive and their state (clone list, expanded row, VPN
         strip state) is preserved across switches. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/card_bg"
        android:padding="8dp">
        <Button android:id="@+id/btnTabClones"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/tab_clones"
            android:textAllCaps="false"
            android:background="@drawable/btn_primary"
            android:textColor="@android:color/white" />
        <Button android:id="@+id/btnTabNotes"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/tab_notes"
            android:textAllCaps="false"
            android:background="@drawable/btn_secondary"
            android:textColor="@color/text_dark" />
    </LinearLayout>
</LinearLayout>
