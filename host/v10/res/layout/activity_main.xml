<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Muse Container — multi-account"
            android:textSize="22sp"
            android:textColor="@color/teal_dark"
            android:textStyle="bold" />
        <!-- v6, direction A: compact collapsible VPN strip at the top.
             UI ONLY: there is no working VPN backend in this build and
             no WireGuard configuration exists yet, so this strip must
             never show a fake Connected state or a fake IP. The
             summary line always stays visible; the detail block below
             it collapses to that one line. The long VPN explanation
             used to sit here (v8); in v9 it lives in the Notes section
             at the bottom and only one short line remains in the card. -->
        <LinearLayout android:id="@+id/vpnStrip"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_vpn_bg"
            android:padding="12dp"
            android:layout_marginBottom="12dp">
            <TextView android:id="@+id/vpnStripSummary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="VPN chung: Tắt — chưa kết nối | Quốc gia: — | IP: —"
                android:textStyle="bold"
                android:textColor="@color/teal_dark" />
            <LinearLayout android:id="@+id/vpnStripDetails"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Quốc gia (chọn để dùng sau — chưa kết nối):" />
                <Spinner android:id="@+id/vpnCountrySpinner"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/vpnIpText"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="IP hiện tại: — (chưa kết nối)" />
                <TextView android:id="@+id/vpnStateText"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Trạng thái: Tắt — chưa có server VPN" />
                <Button android:id="@+id/vpnConnectBtn"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Kết nối VPN (đang tắt — chưa có server)"
            android:background="@drawable/btn_primary_state"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/vpnExplain"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Chưa có server VPN — xem Ghi chú." />
            </LinearLayout>
            <Button android:id="@+id/vpnCollapseBtn"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Thu gọn dải VPN"
            android:background="@drawable/btn_accent"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="8dp"/>
        </LinearLayout>
        <!-- v9, report section 09 two-path add flow: ONE prominent "+"
             entry (Parallel Space "+" pattern) replacing the old numbered
             buttons "1. Pick / import user-supplied APK" and "1b. Pick
             installed app". Tapping it opens the choice between the
             installed-app picker (P1) and the APK-file import; both
             underlying functions are unchanged, only the entry point. -->
        <Button android:id="@+id/btnAddApp"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="+ Thêm app mới"
            android:textSize="18sp"
            android:background="@drawable/btn_primary"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp"/>
        <EditText android:id="@+id/cloneNameInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Clone name (default: Clone 1, Clone 2, ...)" />
        <Button android:id="@+id/btnCreateClone"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="2. Create named clone"
            android:background="@drawable/btn_primary"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btnBattery"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="3. Request battery-optimisation exemption"
            android:background="@drawable/btn_secondary"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btnKeepAlive"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="4. Start keep-alive service (prototype)"
            android:background="@drawable/btn_secondary"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btnRefresh"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Refresh clone list"
            android:background="@drawable/btn_secondary"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="8dp"/>
        <!-- v9: no stale default text here any more. This line is now
             set by code only: a short battery-exemption line on open,
             or a transient operation result (import/launch/error).
             The clone count lives in the list header in code. -->
        <TextView android:id="@+id/statusText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" />
        <LinearLayout android:id="@+id/clonesContainer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
        <!-- v9 tidy-up: ONE collapsible Notes section at the bottom of
             the main screen, collapsed by default. Every long/small
             explanatory paragraph that used to be scattered down the
             main flow now lives here, grouped under short headings.
             Nothing was deleted outright: the meanings are preserved. -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp">
            <Button android:id="@+id/notesToggleBtn"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Ghi chú ▾"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/text_dark" />
            <LinearLayout android:id="@+id/notesContent"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Về app này"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal_dark" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Generic multi-account container (not Muse-only). It does NOT contain, bundle, modify or re-sign any target APK. You supply an app — as an APK file or from the apps already installed on this phone — and each clone keeps its own login and data." />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="VPN"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal_dark" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Dải VPN này hiện chỉ là giao diện: chưa có backend VPN nào hoạt động và chưa có cấu hình WireGuard. Nút Kết nối bị tắt cho đến khi có cấu hình server. Không hiển thị trạng thái Đã kết nối hay IP giả. Chọn quốc gia chỉ lưu lựa chọn để dùng sau, không đổi gì trên mạng." />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Bong bóng và chuyển nhanh"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal_dark" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="- A bubble is a SHORTCUT ICON ONLY. It does NOT show chat content inside the bubble.&#10;- Bubble and fast-switch toggles below default OFF, per clone. Bubbles appear only for ACTIVE clones.&#10;- Drag a bubble to the red strip at the bottom of the screen to hide it (this turns that clone's bubble toggle OFF).&#10;- Fast switching reuses the engine launch path: the target clone opens logged in (guest data is per virtual user), but the engine has NO bring-to-front API, so the exact foreground screen may be recreated. Verify on the phone." />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Thông báo"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal_dark" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Notifications: guest notifications are posted through the engine's notification proxy, not reposted by this host. Verify delay per clone on a real phone." />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Clone đang hoạt động"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal_dark" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Target for simultaneous online: 3-4. Active here means you marked it active — it does NOT mean a guest Muse process is running yet." />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Pin và giữ chạy nền"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal_dark" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Why: Android/Samsung kill background apps. Exemption + a foreground service are required for continuous notifications, but they do NOT guarantee Android will never kill a clone — that must be tested on the real phone.&#10;The Keep-alive button only keeps a host foreground service alive; it does not by itself deliver or label per-clone notifications." />
                <!-- v10: in-app self-update. Lives inside the collapsed
                     Notes section on purpose, so the tidy main screen
                     stays tidy. Manual only: no background check, no
                     auto-download, no silent install — the system
                     installer confirmation dialog always appears. -->
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Cập nhật ứng dụng"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal_dark" />
                <TextView android:id="@+id/updateVersionText"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Phiên bản đang cài: —" />
                <Button android:id="@+id/btnCheckUpdate"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Kiểm tra cập nhật"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_dark" />
                <TextView android:id="@+id/updateStatusText"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
