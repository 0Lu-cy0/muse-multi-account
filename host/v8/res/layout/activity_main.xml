<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Muse Container — multi-account"
            android:textSize="22sp"
            android:textColor="@color/teal_dark"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generic multi-account container (not Muse-only). It does NOT contain, bundle, modify or re-sign any target APK. You supply an app — as an APK file or from the apps already installed on this phone — and each clone keeps its own login and data." />
        <!-- v6, direction A: compact collapsible VPN strip at the top.
             UI ONLY: there is no working VPN backend in this build and
             no WireGuard configuration exists yet, so this strip must
             never show a fake Connected state or a fake IP. The
             summary line always stays visible; the detail block below
             it collapses to that one line. -->
        <LinearLayout android:id="@+id/vpnStrip"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_vpn_bg"
            android:padding="12dp"
            android:layout_marginBottom="12dp">
            <TextView android:id="@+id/vpnStripSummary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="VPN chung: Tắt — chưa kết nối | Quốc gia: — | IP: —"
                android:textStyle="bold"
                android:textColor="@color/teal_dark" />
            <LinearLayout android:id="@+id/vpnStripDetails"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Quốc gia (chọn để dùng sau — chưa kết nối):" />
                <Spinner android:id="@+id/vpnCountrySpinner"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/vpnIpText"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="IP hiện tại: — (chưa kết nối)" />
                <TextView android:id="@+id/vpnStateText"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Trạng thái: Tắt — chưa có server VPN" />
                <Button android:id="@+id/vpnConnectBtn"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Kết nối VPN (đang tắt — chưa có server)" 
            android:background="@drawable/btn_primary_state"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/vpnExplain"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Dải VPN này hiện chỉ là giao diện: chưa có backend VPN nào hoạt động và chưa có cấu hình WireGuard. Nút Kết nối bị tắt cho đến khi có cấu hình server. Không hiển thị trạng thái Đã kết nối hay IP giả." />
            </LinearLayout>
            <Button android:id="@+id/vpnCollapseBtn"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Thu gọn dải VPN" 
            android:background="@drawable/btn_accent"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="8dp"/>
        </LinearLayout>
        <Button android:id="@+id/btnPickApk"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="1. Pick / import user-supplied APK" 
            android:background="@drawable/btn_primary"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btnPickInstalled"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="1b. Pick installed app (new)" 
            android:background="@drawable/btn_primary"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp"/>
        <EditText android:id="@+id/cloneNameInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Clone name (default: Clone 1, Clone 2, ...)" />
        <Button android:id="@+id/btnCreateClone"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="2. Create named clone" 
            android:background="@drawable/btn_primary"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btnBattery"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="3. Request battery-optimisation exemption" 
            android:background="@drawable/btn_secondary"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="8dp"/>
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Why: Android/Samsung kill background apps. Exemption + a foreground service are required for continuous notifications, but they do NOT guarantee Android will never kill a clone — that must be tested on the real phone." />
        <Button android:id="@+id/btnKeepAlive"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="4. Start keep-alive service (prototype)" 
            android:background="@drawable/btn_secondary"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btnRefresh"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Refresh clone list" 
            android:background="@drawable/btn_secondary"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="8dp"/>
        <TextView android:id="@+id/statusText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Status: no APK imported yet." />
        <LinearLayout android:id="@+id/clonesContainer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
